{
  "name": "sws-工法情报系统",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "sync:worker": "node scripts/copy-worker.js",
    "dev": "npm run sync:worker && vite",
    "dev:all": "bash scripts/start-all.sh dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run sync:worker && vite build && node scripts/post-build.js",
    "preview": "vite preview",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "typecheck": "npx tsc --noEmit --pretty",
    "typecheck:watch": "npx tsc --noEmit --pretty --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:file": "bash scripts/test-file.sh",
    "check:env": "bash scripts/check-env.sh",
    "clean": "rm -rf dist public/pdf.min.mjs public/pdf.worker.min.mjs public/cmaps public/standard_fonts public/wasm && echo 'Cleaned build artifacts'"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-pdf-html": "^2.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.2",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}
